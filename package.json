{
  "name": "cfop-trainer",
  "version": "0.1.0",
  "description": "Cross-platform CFOP training app for Bluetooth smart cubes",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "test:all": "npm test && npm run test:e2e",
    "build:ios:sim": "rm -rf 'src-tauri/gen/apple/build/cfop-trainer_iOS.xcarchive' 'src-tauri/gen/apple/build/arm64-sim/CFOP Trainer.app' && tauri ios build --debug --target aarch64-sim --no-sign --ci",
    "tauri": "tauri"
  },
  "license": "MIT",
  "dependencies": {
    "@mnlphlp/plugin-blec": "^0.12.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-sql": "^2.4.0",
    "aes-js": "^3.1.2",
    "lucide-svelte": "^1.0.0",
    "xstate": "^5.32.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@sveltejs/adapter-static": "^3.0.6",
    "@sveltejs/kit": "^2.9.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tauri-apps/cli": "^2",
    "@types/aes-js": "^3.1.4",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
